# Database — create a free Neon project at neon.tech, copy the connection string
DATABASE_URL=postgresql://user:password@host/caretrack

# Session secret — generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-random-secret

# AI — get a free key at console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Stripe — get keys at dashboard.stripe.com
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create two recurring prices in Stripe dashboard, paste the price IDs here:
STRIPE_FAMILY_PRICE_ID=price_...
STRIPE_CAREGIVER_PRICE_ID=price_...

# App
APP_URL=https://care-chain.com
NODE_ENV=production
PORT=5000
